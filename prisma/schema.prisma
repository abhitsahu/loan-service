// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum LoanStatus {
  ACTIVE
  CLOSED

  @@map("loan_status")
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID

  @@map("installment_status")
}

enum AllocationComponent {
  INTEREST
  PRINCIPAL

  @@map("allocation_component")
}

// ---------- Models ----------

model Loan {
  id                 String     @id @default(uuid()) @db.Uuid
  principal          Decimal    @db.Decimal(14, 2)
  annualInterestRate Decimal    @map("annual_interest_rate") @db.Decimal(6, 4)
  tenureMonths       Int        @map("tenure_months")
  disbursementDate   DateTime   @map("disbursement_date") @db.Date
  emiAmount          Decimal    @map("emi_amount") @db.Decimal(14, 2)
  totalInterest      Decimal    @map("total_interest") @db.Decimal(14, 2)
  totalPayable       Decimal    @map("total_payable") @db.Decimal(14, 2)
  status             LoanStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  installments Installment[]
  payments     Payment[]

  @@map("loans")
}

model Installment {
  id                 String            @id @default(uuid()) @db.Uuid
  loanId             String            @map("loan_id") @db.Uuid
  installmentNumber  Int               @map("installment_number")
  dueDate            DateTime          @map("due_date") @db.Date
  openingBalance     Decimal           @map("opening_balance") @db.Decimal(14, 2)
  principalComponent Decimal           @map("principal_component") @db.Decimal(14, 2)
  interestComponent  Decimal           @map("interest_component") @db.Decimal(14, 2)
  totalDue           Decimal           @map("total_due") @db.Decimal(14, 2)
  closingBalance     Decimal           @map("closing_balance") @db.Decimal(14, 2)
  principalPaid      Decimal           @default(0) @map("principal_paid") @db.Decimal(14, 2)
  interestPaid       Decimal           @default(0) @map("interest_paid") @db.Decimal(14, 2)
  amountPaid         Decimal           @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status             InstallmentStatus @default(PENDING)
  settledOn          DateTime?         @map("settled_on") @db.Date

  loan        Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([loanId, installmentNumber])
  @@index([loanId, dueDate, installmentNumber])
  @@map("installments")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  loanId            String   @map("loan_id") @db.Uuid
  amount            Decimal  @db.Decimal(14, 2)
  paymentDate       DateTime @map("payment_date") @db.Date
  idempotencyKey    String   @map("idempotency_key")
  allocatedAmount   Decimal  @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  unallocatedAmount Decimal  @default(0) @map("unallocated_amount") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  loan        Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([loanId, idempotencyKey])
  @@index([loanId, paymentDate(sort: Desc), createdAt(sort: Desc)])
  @@map("payments")
}

model PaymentAllocation {
  id             String              @id @default(uuid()) @db.Uuid
  paymentId      String              @map("payment_id") @db.Uuid
  installmentId  String              @map("installment_id") @db.Uuid
  component      AllocationComponent
  amount         Decimal             @db.Decimal(14, 2)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, installmentId, component])
  @@index([installmentId])
  @@index([paymentId])
  @@map("payment_allocations")
}

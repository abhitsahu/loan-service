# ---------- Database (Supabase) ----------
# Pooled (port 6543) — used by Prisma at runtime (via PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) — used by Prisma for migrations only
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------- Firebase Web SDK (public — shipped to browser) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---------- Firebase Admin SDK (SECRET — server only, never expose) ----------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Single line. Use literal \n for newlines. Wrap the whole value in double-quotes.
FIREBASE_PRIVATE_KEY=""

# ---------- Test ----------
# Direct connection string for the integration test suite
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
